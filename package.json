{
  "name": "agent-wallet-skill",
  "version": "0.3.2",
  "description": "Non-custodial agent wallet toolkit: CLI + agent skills. Create wallets, send, receive, swap, bridge, sign, deploy and verify Solidity contracts. EVM and Bitcoin, local keys, no middleman.",
  "type": "module",
  "license": "MIT",
  "author": "Hector Oviedo",
  "homepage": "https://github.com/hec-ovi/blockchain-skill",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hec-ovi/blockchain-skill.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "agent-wallet": "dist/agent-wallet.mjs",
    "agent-wallet-skill": "dist/agent-wallet.mjs"
  },
  "files": [
    "dist/agent-wallet.mjs",
    "bin/agent-wallet",
    "agent-wallet",
    "SKILL.md",
    "skills/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".env.example"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "test": "vitest run && bash tests/check_skill.sh",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:skills": "bash tests/check_skill.sh",
    "schemas": "node scripts/export-schemas.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "claude-skill",
    "blockchain",
    "wallet",
    "non-custodial",
    "ethereum",
    "bitcoin",
    "evm",
    "solidity",
    "ai-agents",
    "agent-wallet"
  ],
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.54.0",
    "@scure/bip32": "^2.0.0",
    "@scure/bip39": "^2.0.0",
    "@scure/btc-signer": "^2.0.0",
    "@shazow/whatsabi": "^0.27.0",
    "ethereum-cryptography": "^3.2.0",
    "solc": "^0.8.36",
    "viem": "^2.55.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
