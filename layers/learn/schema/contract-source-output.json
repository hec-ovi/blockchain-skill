{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "chainId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "verified": {
      "type": "boolean"
    },
    "source": {
      "type": "string",
      "enum": [
        "sourcify",
        "blockscout",
        "etherscan",
        "whatsabi"
      ]
    },
    "name": {
      "type": "string"
    },
    "abi": {
      "type": "array",
      "items": {}
    },
    "compilerVersion": {
      "type": "string"
    },
    "isProxy": {
      "type": "boolean"
    },
    "implementation": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "address",
    "chainId",
    "verified",
    "source",
    "abi"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/hec-ovi/blockchain-skill/layers/learn/schema/contract-source-output.json"
}
