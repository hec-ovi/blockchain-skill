{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "txid": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "vout": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "valueSats": {
        "type": "string",
        "pattern": "^-?\\d+$"
      },
      "confirmed": {
        "type": "boolean"
      },
      "height": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "txid",
      "vout",
      "valueSats",
      "confirmed"
    ],
    "additionalProperties": false
  },
  "$id": "https://github.com/hec-ovi/blockchain-skill/layers/read/schema/utxo-list-output.json"
}
