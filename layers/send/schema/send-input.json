{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "wallet": {
      "type": "string"
    },
    "passphrase": {
      "type": "string"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "chain": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "amount": {
      "type": "string"
    },
    "amountRaw": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d+$"
        },
        {
          "type": "string",
          "const": "all"
        }
      ]
    },
    "token": {
      "type": "string"
    },
    "data": {
      "type": "string",
      "pattern": "^0x"
    },
    "addressType": {
      "type": "string",
      "enum": [
        "p2tr",
        "p2wpkh"
      ]
    },
    "feeRateSatVb": {
      "type": "number",
      "minimum": 1,
      "maximum": 5000
    },
    "rpc": {
      "type": "string"
    },
    "wait": {
      "type": "boolean"
    },
    "timeoutMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "wallet",
    "passphrase",
    "chain",
    "to"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/hec-ovi/blockchain-skill/layers/send/schema/send-input.json"
}
