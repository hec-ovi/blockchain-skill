{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "chain": {
      "type": "string"
    },
    "chainId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "txHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "deployer": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "contractName": {
      "type": "string"
    },
    "abi": {
      "type": "array",
      "items": {}
    },
    "compilerVersion": {
      "type": "string"
    },
    "gasUsed": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "explorer": {
      "type": "string"
    }
  },
  "required": [
    "chain",
    "chainId",
    "address",
    "txHash",
    "deployer",
    "contractName",
    "abi",
    "gasUsed"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/hec-ovi/blockchain-skill/layers/contracts/schema/deploy-output.json"
}
