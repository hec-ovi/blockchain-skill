{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "function": {
      "type": "string"
    },
    "hash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "from": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "broadcast",
        "confirmed",
        "reverted"
      ]
    },
    "blockNumber": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "gasUsed": {
      "type": "string",
      "pattern": "^\\d+$"
    }
  },
  "required": [
    "function",
    "hash",
    "from",
    "status"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/hec-ovi/blockchain-skill/layers/contracts/schema/write-output.json"
}
