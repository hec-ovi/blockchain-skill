{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string"
    },
    "step": {
      "type": "string"
    },
    "index": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "total": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "visits": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "workDir": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "type": "string"
    },
    "next": {
      "type": "string"
    },
    "nextCommand": {
      "type": "string"
    }
  },
  "required": [
    "mode",
    "step",
    "index",
    "total",
    "visits",
    "workDir",
    "body",
    "nextCommand"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/hec-ovi/blockchain-skill/layers/workflow/schema/step-output.json"
}
