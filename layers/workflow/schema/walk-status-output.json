{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workDir": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "started": {
      "type": "boolean"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string"
          },
          "visits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "artifact": {
            "type": "string"
          },
          "saved": {
            "type": "boolean"
          }
        },
        "required": [
          "step",
          "visits",
          "saved"
        ],
        "additionalProperties": false
      }
    },
    "blockedBy": {
      "type": "string"
    }
  },
  "required": [
    "workDir",
    "started",
    "steps"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/hec-ovi/blockchain-skill/layers/workflow/schema/walk-status-output.json"
}
