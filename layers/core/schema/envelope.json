{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {},
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "layer": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "chain": {
          "type": "string"
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "traceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "layer",
        "backend",
        "elapsedMs",
        "traceId"
      ],
      "additionalProperties": {}
    }
  },
  "required": [
    "contractVersion",
    "ok",
    "meta"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/hec-ovi/blockchain-skill/layers/core/schema/envelope.json"
}
