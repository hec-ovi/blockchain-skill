{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tool": {
      "type": "string"
    },
    "fromChainId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "toChainId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "from": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "approvalTx": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "sourceTx": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "toAmountMin": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "status": {
      "type": "string",
      "const": "broadcast"
    },
    "hint": {
      "type": "string"
    }
  },
  "required": [
    "tool",
    "fromChainId",
    "toChainId",
    "from",
    "sourceTx",
    "toAmountMin",
    "status",
    "hint"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/hec-ovi/blockchain-skill/layers/bridge/schema/bridge-execute-output.json"
}
