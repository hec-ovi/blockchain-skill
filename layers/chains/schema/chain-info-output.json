{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "const": "evm"
        },
        "chainId": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shortName": {
          "type": "string"
        },
        "rpcUrls": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?:\\/\\/"
          }
        },
        "explorers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nativeCurrency": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "symbol": {
              "type": "string"
            },
            "decimals": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "name",
            "symbol",
            "decimals"
          ],
          "additionalProperties": false
        },
        "testnet": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "enum": [
            "viem",
            "registry"
          ]
        }
      },
      "required": [
        "family",
        "chainId",
        "name",
        "rpcUrls",
        "explorers",
        "nativeCurrency",
        "testnet",
        "source"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "const": "btc"
        },
        "network": {
          "type": "string",
          "enum": [
            "bitcoin",
            "signet",
            "testnet",
            "regtest"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "esploraUrls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bitcoindRpc": {
          "type": "string"
        },
        "testnet": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "const": "builtin"
        }
      },
      "required": [
        "family",
        "network",
        "name",
        "esploraUrls",
        "testnet",
        "source"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "https://github.com/hec-ovi/blockchain-skill/layers/chains/schema/chain-info-output.json"
}
