{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "wallet": {
      "type": "string"
    },
    "passphrase": {
      "type": "string"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "network": {
      "type": "string",
      "enum": [
        "bitcoin",
        "signet",
        "testnet"
      ]
    },
    "addressType": {
      "type": "string",
      "enum": [
        "p2tr",
        "p2wpkh"
      ]
    },
    "to": {
      "type": "string"
    },
    "amountSats": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d+$"
        },
        {
          "type": "string",
          "const": "all"
        }
      ]
    },
    "feeRateSatVb": {
      "type": "number",
      "minimum": 1,
      "maximum": 5000
    },
    "utxos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "txid": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "vout": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "valueSats": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "confirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "txid",
          "vout",
          "valueSats",
          "confirmed"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "wallet",
    "passphrase",
    "network",
    "to",
    "amountSats",
    "feeRateSatVb",
    "utxos"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/hec-ovi/blockchain-skill/layers/sign/schema/btc-sign-input.json"
}
