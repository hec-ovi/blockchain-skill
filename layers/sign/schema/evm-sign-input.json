{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "wallet": {
      "type": "string"
    },
    "passphrase": {
      "type": "string"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "chainId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "to": {
      "type": "string"
    },
    "valueWei": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "data": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]*$"
    },
    "nonce": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "gasLimit": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "maxFeePerGas": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "maxPriorityFeePerGas": {
      "type": "string",
      "pattern": "^\\d+$"
    }
  },
  "required": [
    "wallet",
    "passphrase",
    "chainId",
    "nonce",
    "gasLimit",
    "maxFeePerGas",
    "maxPriorityFeePerGas"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/hec-ovi/blockchain-skill/layers/sign/schema/evm-sign-input.json"
}
