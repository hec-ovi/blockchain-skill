{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hardfork": {
      "type": "string"
    },
    "compilerVersion": {
      "type": "string"
    },
    "accounts": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      }
    },
    "deployed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "as": {
            "type": "string"
          },
          "contract": {
            "type": "string"
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "gasUsed": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "runtimeSizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "overSizeLimit": {
            "type": "boolean"
          }
        },
        "required": [
          "as",
          "contract",
          "address",
          "gasUsed",
          "runtimeSizeBytes",
          "overSizeLimit"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "call",
              "send"
            ]
          },
          "from": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "to": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "fn": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "pass": {
            "type": "boolean"
          },
          "gasUsed": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "returns": {
            "type": "string"
          },
          "revert": {
            "type": "string"
          },
          "logs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "address": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{40}$"
                },
                "event": {
                  "type": "string"
                },
                "args": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "address",
                "event",
                "args"
              ],
              "additionalProperties": false
            }
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "index",
          "name",
          "kind",
          "from",
          "to",
          "fn",
          "ok",
          "pass",
          "logs"
        ],
        "additionalProperties": false
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "held": {
            "type": "boolean"
          },
          "expected": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          },
          "op": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "held",
          "expected",
          "actual",
          "op"
        ],
        "additionalProperties": false
      }
    },
    "balances": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\d+$"
      }
    },
    "pass": {
      "type": "boolean"
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "hardfork",
    "compilerVersion",
    "accounts",
    "deployed",
    "steps",
    "invariants",
    "balances",
    "pass",
    "failures",
    "warnings"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/hec-ovi/blockchain-skill/layers/sandbox/schema/run-output.json"
}
