{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "adapter": {
      "type": "string"
    },
    "chainId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "sellToken": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "buyToken": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "sellAmount": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "buyAmount": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "minBuyAmount": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "spender": {
      "type": "string"
    },
    "estimatedGas": {
      "type": "string"
    },
    "execution": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tx"
            },
            "to": {
              "type": "string"
            },
            "data": {
              "type": "string"
            },
            "value": {
              "type": "string",
              "pattern": "^\\d+$"
            }
          },
          "required": [
            "kind",
            "to",
            "data",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "order"
            },
            "order": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "postUrl": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "order",
            "postUrl"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "adapter",
    "chainId",
    "sellToken",
    "buyToken",
    "sellAmount",
    "buyAmount",
    "minBuyAmount",
    "spender",
    "execution"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/hec-ovi/blockchain-skill/layers/swap/schema/swap-quote-output.json"
}
