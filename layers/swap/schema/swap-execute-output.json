{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "adapter": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "tx",
        "order"
      ]
    },
    "approvalTx": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "swapTx": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "orderUid": {
      "type": "string"
    },
    "from": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "sellToken": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "buyToken": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "sellAmount": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "minBuyAmount": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "hint": {
      "type": "string"
    }
  },
  "required": [
    "adapter",
    "kind",
    "from",
    "sellToken",
    "buyToken",
    "sellAmount",
    "minBuyAmount",
    "hint"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/hec-ovi/blockchain-skill/layers/swap/schema/swap-execute-output.json"
}
