{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "passphrase": {
      "type": "string",
      "minLength": 8
    },
    "words": {
      "anyOf": [
        {
          "type": "number",
          "const": 12
        },
        {
          "type": "number",
          "const": 24
        }
      ]
    }
  },
  "required": [
    "name",
    "passphrase"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/hec-ovi/blockchain-skill/layers/keys/schema/create-wallet-input.json"
}
