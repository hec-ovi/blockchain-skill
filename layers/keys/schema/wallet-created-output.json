{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "file": {
      "type": "string"
    },
    "mnemonic": {
      "type": "string"
    },
    "warning": {
      "type": "string"
    },
    "evmAddress": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "btcAddress": {
      "type": "string",
      "minLength": 14
    }
  },
  "required": [
    "name",
    "file",
    "mnemonic",
    "warning",
    "evmAddress",
    "btcAddress"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/hec-ovi/blockchain-skill/layers/keys/schema/wallet-created-output.json"
}
