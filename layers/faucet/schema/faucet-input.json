{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "network": {
      "type": "string",
      "enum": [
        "base-sepolia",
        "base-testnet",
        "ethereum-sepolia",
        "sepolia"
      ]
    },
    "token": {
      "type": "string",
      "enum": [
        "eth",
        "usdc",
        "eurc",
        "cbbtc"
      ]
    }
  },
  "required": [
    "address",
    "network"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/hec-ovi/blockchain-skill/layers/faucet/schema/faucet-input.json"
}
