{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "network": {
      "type": "string"
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "token": {
      "type": "string",
      "enum": [
        "eth",
        "usdc",
        "eurc",
        "cbbtc"
      ]
    },
    "transactionHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "explorer": {
      "type": "string"
    }
  },
  "required": [
    "network",
    "address",
    "token",
    "transactionHash",
    "explorer"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/hec-ovi/blockchain-skill/layers/faucet/schema/faucet-output.json"
}
