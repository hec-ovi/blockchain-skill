# Copy this file to .env and fill in your values. .env is git-ignored.

# Keystore passphrase (encrypts your wallet on disk). Required to sign/send.
AGENT_WALLET_PASSPHRASE=

# Free Coinbase CDP faucet key (portal.cdp.coinbase.com/api-keys/secret).
# Only needed for the `faucet` verb that loads testnet credits. Testnet only.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional: raises rate limits, not required.
# ETHERSCAN_API_KEY=
# LIFI_API_KEY=
